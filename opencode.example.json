{
  "$schema": "https://opencode.ai/config.json",

  "model": "anthropic/claude-opus-5",
  "small_model": "anthropic/claude-haiku-4-5",

  "instructions": ["AGENTS.md"],

  "agent": {
    "mentor": { "model": "anthropic/claude-opus-5" },
    "cartographer": { "model": "anthropic/claude-opus-5" },
    "reviewer": { "model": "anthropic/claude-opus-5" },
    "curator": { "model": "anthropic/claude-sonnet-5" },
    "calibrator": { "model": "anthropic/claude-sonnet-5" },
    "examiner": { "model": "anthropic/claude-sonnet-5" }
  },

  "mcp": {
    "mentor": {
      "type": "local",
      "command": ["/absolute/path/to/Learning System/.venv/bin/python", "-m", "mentor.server"],
      "environment": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUNBUFFERED": "1"
      },
      "enabled": true,
      "timeout": 60000
    }
  }
}
